PORT=32288
# LLM — OpenRouter FREE (generowanie pytań live w języku urządzenia)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=openrouter/free
# Jev — TypeSafe https://docs.typesafe.ai/api
# Opcja A (polecana, free promo na Vercel do 2026-09-25): Vercel AI Gateway, model typesafe-ai/jev
# Klucz: Vercel Dashboard → AI Gateway → Create API Key. Wymaga karty w teamie (użycie w promo free).
AI_GATEWAY_API_KEY=
JEV_GATEWAY_MODEL=typesafe-ai/jev
# Opcja B (fallback): bezpośrednie TypeSafe API
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
JEV_THRESHOLD=0.80
# Solana Devnet per https://solana.com/developers
SOLANA_RPC=https://api.devnet.solana.com
# Optional real payout: SOLANA_PAYER_PRIVATE_KEY=[1,2,...]
